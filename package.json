{
  "name": "kazuhoshibuya.com",
  "private": true,
  "description": "Personal site of Kazuho Shibuya, served from Cloudflare.",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test:unit": "python3 -m unittest discover tests",
    "check": "npm run test:unit && python3 scripts/build.py && html-validate public/index.html && playwright test",
    "screenshots:update": "playwright test -g \"looks the same\" --project chrome --update-snapshots",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "fontkit": "^2.0.4",
    "html-validate": "^11.16.2",
    "pngjs": "^7.0.0",
    "wrangler": "^4.149.0"
  }
}
